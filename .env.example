# Example environment file. Contains NAMES ONLY — never commit real values.
# Local development: copy to .env (git-ignored). Deployments: GitHub Environment secrets
# (build-time VITE_* values) and Cloudflare Worker secrets (server runtime values).

# --- Browser-visible (publishable) configuration, baked in at build time -----------------
# URL of the university-owned Supabase project, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
# Publishable/anon key (sb_publishable_… or the anon JWT). Protected by RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: project ref (informational)
VITE_SUPABASE_PROJECT_ID=

# --- Server-side configuration (Worker runtime secrets) ---------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Service-role/secret key: server only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Project ref of the university Supabase project (used by tooling/preflight checks)
SUPABASE_PROJECT_ID=
# Public origin of the deployed app, e.g. https://timetable.example.edu (password-reset links)
SITE_URL=
# "1" to send Content-Security-Policy as Report-Only (rollout); empty/unset = enforced
CSP_REPORT_ONLY=
